# Copy to .env and adjust for your platform. Unset, the client defaults to
# http://localhost:8080 on iOS/web and http://10.0.2.2:8080 on the Android
# emulator (see src/api/env.ts) — set this explicitly for a physical device,
# pointing at your machine's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
