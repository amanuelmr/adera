{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "settings": {
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 400,
          "throughputKbps": 400,
          "cpuSlowdownMultiplier": 4
        },
        "skipAudits": [
          "robots-txt"
        ]
      }
    },
    "assert": {
      "assertions": {
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 307200
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 102400
          }
        ],
        "interactive": [
          "error",
          {
            "maxNumericValue": 5000
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    }
  }
}
