# Copy to .env for local development outside Docker (direnv/source it).
# Every value here is a development placeholder.

APP_ENV=development                # development | test | production
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080

DATABASE_URL=postgres://adera:adera@localhost:55432/adera?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_QUERY_TIMEOUT=5s

# >= 32 bytes. Required in production.
JWT_SECRET=dev-only-secret-change-me-32-bytes!!
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Argon2id parameters (OWASP minimum enforced at startup).
ARGON_MEMORY_KIB=19456
ARGON_ITERATIONS=2
ARGON_PARALLELISM=1

# Object storage (MinIO in development).
STORAGE_ENABLED=true
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=adera-dev
STORAGE_SECRET_KEY=adera-dev-secret
STORAGE_USE_SSL=false
STORAGE_PUBLIC_BUCKET=adera-public
STORAGE_PRIVATE_BUCKET=adera-private
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/adera-public

CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ENABLED=true

LOG_LEVEL=info                     # debug | info | warn | error
LOG_FORMAT=json                    # json | text

# Development seed credentials. Seeding refuses to run in production and
# SEED_ADMIN_PASSWORD must not be set there (startup validation enforces it).
SEED_ADMIN_EMAIL=admin@adera.local
SEED_ADMIN_PASSWORD=admin12345!

# Integration tests: admin connection used to create disposable databases.
TEST_DATABASE_ADMIN_URL=postgres://adera:adera@localhost:55432/postgres?sslmode=disable
